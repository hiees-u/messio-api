generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String?   @unique
  name      String
  createdAt DateTime @default(now())
  facebookAccounts UserFacebook[]
  workSpaces WorkSpace[]
  googleAuth GoogleAuth?
}

model UserFacebook {
  id          Int      @id @default(autoincrement())
  facebookId  String   @unique
  name        String
  email       String?  @unique

  userId      Int?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  picture     PictureUserFacebook?
  accessToken UserAccessToken?
  faceBookPage FaceBookPage[]
}

model PictureUserFacebook {
  id            Int      @id @default(autoincrement())
  height        Int
  isSilhouette Boolean
  url           String
  width         Int

  userFacebookId        Int @unique
  userFacebook          UserFacebook @relation(fields: [userFacebookId], references: [id], onDelete: Cascade)
}

model UserAccessToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  expiresAt DateTime

  userFacebookId    Int @unique
  userFacebook      UserFacebook @relation(fields: [userFacebookId], references: [id], onDelete: Cascade)
}

model FaceBookPage {
  id        Int     @id @default(autoincrement())
  token     String  @unique
  name      String
  tasks     String[]
  pageId String @unique

  userFacebookId  Int
  userFacebook UserFacebook @relation(fields: [userFacebookId], references: [id], onDelete: Cascade)

  pageSetting PageSetting?
  workSpaces WorkSpace[]

  rooms Rooms[]
}

model Customers {
  id        Int     @id @default(autoincrement())
  name      String
  psid      String  @unique

  rooms Rooms?
}

model Rooms {
  id       Int     @id @default(autoincrement())
  pageId   Int
  customerId Int   @unique

  page     FaceBookPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  customer Customers @relation(fields: [customerId], references: [id], onDelete: Cascade)
  messages Messages[]
  @@unique([pageId, customerId])
}

model Messages {
  id        Int     @id @default(autoincrement())
  mid       String  @unique
  roomId    Int
  text      String
  type      String?
  senders    Int[]
  createdAt DateTime @default(now())
  modifiedAt DateTime @default(now()) @updatedAt

  room      Rooms @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model PageSetting {
  id        Int     @id @default(autoincrement())
  pageId    Int     @unique
  isActive  Boolean @default(true)
  isAlertEmail Boolean @default(false)

  page      FaceBookPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
}

model WorkSpace {
  id        Int     @id @default(autoincrement())
  pageId    Int
  userId    Int
  createdAt DateTime @default(now())
  modifiedAt DateTime @updatedAt

  page      FaceBookPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([pageId, userId])

  permissions Permission[]
}

model GoogleAuth {
  id        Int     @id @default(autoincrement())
  googleId  String  @unique
  avataUrl String
  userId   Int     @unique
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Permission {
  id        Int     @id @default(autoincrement())
  workSpaceId Int
  permission String @default("read")
  workSpace WorkSpace @relation(fields: [workSpaceId], references: [id], onDelete: Cascade)

  @@unique([workSpaceId, permission])
}